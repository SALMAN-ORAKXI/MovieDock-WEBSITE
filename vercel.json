{
  "routes": [
    {
      "src": "/",
      "dest": "/__server"
    },
    {
      "src": "/index.html",
      "dest": "/__server"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/assets/(.*)"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}
